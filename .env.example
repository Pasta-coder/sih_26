# ─── Application ───────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./compliance.db
# For PostgreSQL (production): postgresql://user:password@localhost:5432/compliance_db

# ─── Tier 1 Reseller APIs ────────────────────────────────────────────────────
# GST Verification (e.g. Sandbox.co.in)
GST_API_KEY=your_gst_sandbox_api_key
GST_API_BASE_URL=https://api.sandbox.co.in/gst

# PAN Verification
PAN_API_KEY=your_pan_api_key
PAN_API_BASE_URL=https://api.sandbox.co.in/kyc/pan

# EPFO/ESIC Verification (e.g. Deepvue / AuthBridge)
EPFO_API_KEY=your_epfo_api_key
EPFO_API_BASE_URL=https://api.deepvue.tech/v1

# MCA21 Company Master Data
MCA_API_KEY=your_mca_api_key
MCA_API_BASE_URL=https://api.authbridge.com/mca

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set USE_REAL_TIER1_APIS=false to use realistic mock adapters (safe for demo)
USE_REAL_TIER1_APIS=false
